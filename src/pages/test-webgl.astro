---
import PageLayout from "@/layouts/PageLayout.astro";
import Container from "@/components/main/Container.astro";
import SimpleWebGLTest from "@/components/webgl/SimpleWebGLTest";
import MasonryGridSection from "@/components/webgl/MasonryGridSection";
import MasonrySanityGridSection from "@/components/webgl/MasonrySanityGridSection";
import { getAllPhotos, urlForImage } from "@/lib/sanity";

// Fetch Sanity images at build time
const photos = await getAllPhotos(12);
const sanityImages = photos.map((photo) => {
  const width = photo.image?.asset?.metadata?.dimensions?.width || photo.dimensions?.width || 400;
  const height = photo.image?.asset?.metadata?.dimensions?.height || photo.dimensions?.height || 400;
  return {
    ...photo,
    image: {
      src: photo.image 
        ? urlForImage(photo.image).format("webp").width(1200).quality(85).url()
        : "/images/no-image.svg",
      alt: photo.altText || photo.title,
      width,
      height,
    },
  };
});
---
<PageLayout
  title="WebGL Distortion Test"
  description="Testing WebGL fluid distortion effects for the photo gallery"
>
  <section class="w-full py-20">
    <Container>
      <h1 class="text-3xl font-bold mb-6">WebGL Distortion Test</h1>
      <p class="text-muted-foreground mb-8">
        Testing pure WebGL liquid distortion effects (no React Three Fiber dependencies)
        <MasonrySanityGridSection client:load images={sanityImages} />
      </div>
    </Container>
  </section>


</PageLayout>


<style>
  canvas {
    display: block;
  }
</style>