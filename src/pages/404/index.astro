---
import { Container } from "@/components/main/Container";
import { Button } from "@/components/ui/button";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout title="404 | Page Not Found" description="Page not found">
  <Container
    className="text-center flex flex-col items-center justify-center h-[100vh]">
    <div>
      <h1 class="text-4xl font-bold">404</h1>
      <p>Page not found</p>
      <Button>
        <a href="/">Go to home</a>
      </Button>
    </div>
  </Container>
</PageLayout>
