---
import Container from "@/components/main/Container.astro";
import { Icon } from "@/components/main/Icon";
import { Button } from "@/components/shad-ui/button";
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="404 - Page Not Found | Simon Bremner"
  description="Page not found">
  <Container
    className="flex flex-col gap-4 items-center justify-center flex-grow h-full w-full min-h-200">
    <h1 class="text-4xl md:text-6xl lg:text-7xl xl:text-9xl font-bold mb-10">
      404 - Nothing's here
    </h1>
    <div class="flex gap-4">
      <a href="/">
        <Button className="cursor-pointer"
          >Home<Icon name="home" size={24} /></Button
        >
      </a>
      <a href="/about">
        <Button className="cursor-pointer" variant="outline">
          About<Icon name="user" size={24} />
        </Button>
      </a>
    </div>
  </Container>
</PageLayout>
