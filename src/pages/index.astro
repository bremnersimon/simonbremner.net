---
import PageLayout from "@/layouts/PageLayout.astro";
import HomepageHero from "@/components/main/HomepageHero";
import TabbedPostSlider from "@/components/main/TabbedPostSlider";
import LargeText from "@/components/main/LargeText";
import AnimateOnLoad from "@/components/motion/AnimateOnLoad";
import { getHomePageProjects } from "@/lib/sanity";
import type { ProjectCardProps } from "@/types";
import ravanelBridge from "@/assets/ravanel-bridge.jpg";
import { Image } from "astro:assets";
import HorizontalScrolling from "@/components/main/HorizontalScrolling.astro";
const data: { featuredProjects: ProjectCardProps[] } =
  await getHomePageProjects();
---

<PageLayout title="Home | Simon Bremner" description="Welcome to my portfolio">
  <AnimateOnLoad
    client:load
    variants={{
      hidden: { opacity: 0, y: -20 },
      visible: { opacity: 1, y: 0, transition: { duration: 0.6 } },
    }}
    tag="section">
    <HomepageHero
      title={["Crafting Moments,", "Building Connections"]}
      primaryCta={{
        text: "About Me",
        href: "/about",
        icon: "user",
      }}
    />
    <Image
      class="block md:hidden"
      priority
      src={ravanelBridge}
      alt="Ravanel Bridge"
    />
    <HorizontalScrolling />
  </AnimateOnLoad>
  <LargeText
    className="py-24"
    client:load
    content={"Welcome to my portfolio—a site documenting my creative journey and professional evolution. Browse through these visual stories and technical experiments, shared for fellow enthusiasts and anyone seeking inspiration for their next expedition."}
  />
  <div id="projects" class="overflow-hidden">
    <TabbedPostSlider
      client:load
      title="Recent Projects"
      categories={[
        "All",
        "Photography",
        "Design",
        "Development",
        "Handcrafted",
      ]}
      defaultTab="All"
      featuredProjects={data.featuredProjects}
    />
  </div>
</PageLayout>
