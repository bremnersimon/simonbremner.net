---
import Footer from "@/components/globals/Footer";
import Layout from "../layouts/Layout.astro";
import HomepageHero from "@/components/main/HomepageHero";
import TabbedPostSlider from "@/components/main/TabbedPostSlider";
import LargeText from "@/components/main/LargeText";
import AnimateOnLoad from "@components/motion/AnimateOnLoad";
import { getHomePageProjects } from "@/lib/sanity";

const data = await getHomePageProjects();
---

<Layout>
	<AnimateOnLoad
		client:load
		variants={{
			hidden: { opacity: 0, y: -20 },
			visible: { opacity: 1, y: 0, transition: { duration: 0.6 } },
		}}
		tag="section"
		className="py-20 text-center"
	>
		<HomepageHero
			title="Crafting Moments, Building Connections"
			subtitle="Photographer, developer, designer, and maker—bringing ideas to life through multiple creative languages that connect people with what matters most."
			mediaUrl={{
				src: "/images/example-2.jpg",
				alt: "Example",
				video: false,
			}}
			primaryCta={{ text: "About Me", href: "/about" }}
		/>
	</AnimateOnLoad>
	<LargeText
		client:load
		content={[
			"This is my creative archive—a personal collection documenting my journey as a photographer, developer, designer, and maker. Here I gather projects spanning multiple disciplines, each representing a spark of curiosity or a challenge that captivated my attention.",
			"This space serves as both memory and motivation, helping me track my creative evolution across different mediums. While primarily for my own reflection, I'm sharing these documented journeys for anyone who finds inspiration in the intersection of visual storytelling, code, and craftsmanship.",
		]}
	/>

	<TabbedPostSlider
		client:load
		title="Recent Projects"
		subtitle="A selection of creative work across multiple disciplines"
		categories={[
			"All",
			"Photography",
			"Design",
			"Development",
			"Handcrafted",
		]}
		defaultTab="All"
		featuredProjects={data.featuredProjects}
	/>
</Layout>
