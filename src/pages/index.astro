---
import PageLayout from "@/layout/PageLayout.astro";
import Container from "@/components/main/Container.astro";
import AnimatedHero from "@/components/main/AnimatedHero.astro";
import { mapGalleryPhoto } from "@/lib/galleryPhoto";
import { getAllPhotos } from "@/lib/sanity";
import MasonryGallery from "@/components/main/MasonryGallery";
import ogImage from "@/assets/main-og-image.jpg";

const initialPhotosPerPage = 6;
const photos = await getAllPhotos(initialPhotosPerPage, 0);
const galleryPhotos = photos.map(mapGalleryPhoto);
const lcpPhoto = galleryPhotos[0];
---

<PageLayout
    title="Gallery | Simon Bremner"
    description="A photography gallery created and curated by Simon Bremner."
    image={ogImage}
>

    <section id="gallery" class="w-full pt-24 pb-20">
        <Container>
            <h1 class="text-4xl font-bold mb-8">
                <span class="">A Multidisciplinary Visual Creative working</span>
                <span class="text-primary">{"."}</span>
            </h1>
        </Container>
    </section>
</PageLayout>
