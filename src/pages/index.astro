---
import PageLayout from "@/layouts/PageLayout.astro";
import Container from "@/components/main/Container.astro";
import AnimatedHero from "@/components/main/AnimatedHero.astro";
import { mapGalleryPhoto } from "@/lib/galleryPhoto";
import { getAllPhotos } from "@/lib/sanity";
import LazyMasonryGallery from "@/components/webgl/LazyMasonryGallery";
import ogImage from "@/assets/main-og-image.jpg";

const initialPhotosPerPage = 12;
const photos = await getAllPhotos(initialPhotosPerPage, 0);
const galleryPhotos = photos.map(mapGalleryPhoto);
---

<PageLayout
    title="Gallery | Simon Bremner"
    description="A photography gallery."
    image={ogImage}
>
    <section id="gallery" class="w-full pt-24 pb-20">
        <Container>
            <AnimatedHero
                headline="Gallery"
                ariaLabel="Gallery"
                uppercase
                noWrap
                containerClassName="mb-[clamp(1.25rem,3vw,2.5rem)] w-full"
                headlineClassName="font-thin [line-height:0.88] [letter-spacing:0.015em] text-[3.25rem] sm:text-[4.75rem] md:text-[6.5rem] lg:text-[8.5rem] xl:text-[10.5rem] 2xl:text-[12rem]"
            />
            <LazyMasonryGallery
                client:load
                initialImages={galleryPhotos}
                photosPerPage={15}
            />
        </Container>
    </section>
</PageLayout>

<style>
    .photo-item {
        page-break-inside: avoid;
        break-inside: avoid;
    }

    [data-slot="dialog-overlay"] {
        backdrop-filter: blur(8px);
    }
</style>
