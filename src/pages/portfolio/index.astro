---
import { PortfolioArchive } from "@/components/portfolio/PortfolioArchive";
import PageLayout from "@/layouts/PageLayout.astro";
import { getPortfolioPosts, urlForImage } from "@/lib/sanity";
import type { PortfolioPost } from "@/types/portfolio";

const posts = (await getPortfolioPosts(48)) as PortfolioPost[];
const archivePosts = posts.map((post) => {
	const slug = post.slug?.current;

	return {
		_id: post._id,
		headline: post.headline,
		introduction: post.introduction,
		slug,
		href: slug ? `/portfolio/${slug}` : undefined,
		category: post.category || [],
		serviceTags: post.serviceTags || [],
		imageUrl: post.heroImage?.asset
			? urlForImage(post.heroImage)
					.width(900)
					.height(600)
					.fit("crop")
					.format("webp")
					.url()
			: "",
		imageAlt: post.heroImage?.alt || post.headline || "Portfolio image",
	};
});
---

<PageLayout title="Portfolio | Simon Bremner" description="Portfolio project posts." mainTransition="none">
	<section class="mx-auto w-full max-w-6xl px-4 pb-16 pt-28 sm:px-6 lg:px-8">
		<header class="mb-10 space-y-2">
			<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Portfolio</h1>
			<p class="max-w-2xl text-sm text-muted-foreground">A collection of project write-ups and visual case studies.</p>
		</header>

		{archivePosts.length > 0 ? (
			<PortfolioArchive client:load posts={archivePosts} />
		) : (
			<div class="rounded-lg border border-dashed border-border p-10 text-center">
				<p class="text-sm text-muted-foreground">No portfolio posts found.</p>
			</div>
		)}
	</section>
</PageLayout>
