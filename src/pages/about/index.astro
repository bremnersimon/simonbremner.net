---
import AnimateOnLoad from "@/components/motion/AnimateOnLoad";
import Layout from "@/layouts/Layout.astro";
import AboutHero from "@/components/main/AboutHero";
import { Image } from "astro:assets";
import headshot from "@/assets/sb-headshot.jpg";
import { FadingSection } from "@/components/main/FadingSection";
import LargeText from "@/components/main/LargeText";
import { Container } from "@/components/main/Container";
import { Cta } from "@/components/main/Cta";

const heroText = {
  headline: "About Me",
  paragraphs: [
    "I started as a Graphic Designer before moving into a career in development. Along the way, I've picked up a few creative pursuits. This website is dedicated to sharing my experiences as I grow my personal and professional skills.",
    "I'm not here to sell my services to you. This page is solely here to share my journey and potentially inspire someone to continue their journey.",
  ],
};

const largeText = [
  "The projects on this website are not 'complete' and will most likely never be. They are merely a reflection of my journey as a creative. They are not perfect in any way, but I'm going to keep making them!",
  "If you're interested in learning more about my background, skills, and interests, please continue reading. I'm here to share my journey and inspire others to continue their own journey.",
];
const highlightedWords = ["complete", "perfect"];
const highlightStyle = {
  backgroundColor: "#f0f0f0",
  color: "#000",
};
---

<Layout>
  <Container>
    <AboutHero client:load content={heroText}>
      <Image
        class="rounded-lg aspect-square object-cover"
        src={headshot}
        alt="Headshot"
      />
    </AboutHero>
  </Container>
  <Container className="py-20">
    {
      largeText.map((paragraph, index) => (
        <LargeText
          index={index}
          client:load
          content={paragraph}
          className="py-20"
        />
      ))
    }
  </Container>
  <Container>
    <FadingSection client:load />
  </Container>
  <!-- TODO: Add CTA back in -->
  <!-- <Container>
    <Cta client:load />
  </Container> -->
</Layout>
