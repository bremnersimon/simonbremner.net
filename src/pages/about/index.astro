---
import ogImage from "@/assets/about-og-image.jpg";
import headshot from "@/assets/sb-headshot.jpg";
import AnimatedHero from "@/components/main/AnimatedHero.astro";
import Container from "@/components/main/Container.astro";
import EquipmentSection from "@/components/main/EquipmentSection.astro";
import FilmDistortionImage from "@/components/webgl/FilmDistortionImage";
import SocialLinks from "@/components/main/SocialLinks.astro";
import PageLayout from "@/layout/PageLayout.astro";
import {
  getCameras,
  getLenses,
  getSocialLinks,
  getSoftwareTypes,
} from "@/lib/sanity";
import type { AboutHeroTextProps } from "@/types/types";
import type { Camera, Lens, SoftwareType } from "@/types/sanity/sanity.types";

const heroText: AboutHeroTextProps = {
  headline: "About",
  paragraphs: [
    "Hello, my name is Simon Bremner. I'm a Graphic Designer and Full Stack Developer who loves taking photos. This website serves as a representation of my interests. I hope you enjoy.",
  ],
};

// Fetch equipment data
const [cameras, lenses, softwareItems, socialLinks] = await Promise.all([
  getCameras() as Promise<Camera[]>,
  getLenses() as Promise<Lens[]>,
  getSoftwareTypes() as Promise<SoftwareType[]>,
  getSocialLinks(),
]);
---

<PageLayout
  title="About Me | Simon Bremner"
  description="About me"
  image={ogImage}
>
  <Container className="px-4 lg:px-0 lg:px-0">
    <AnimatedHero
      headline={heroText.headline}
      paragraphs={heroText.paragraphs}
      uppercase
      containerClassName="flex flex-col items-start justify-center gap-8 pt-20"
      textContainerClassName="mb-6"
      headlineClassName="font-thin [line-height:0.88] [letter-spacing:0.015em] text-[3.25rem] sm:text-[4.75rem] md:text-[6.5rem] lg:text-[8.5rem] xl:text-[10.5rem] 2xl:text-[12rem]"
      paragraphClassName="text-muted-foreground text-sm sm:text-base mt-4 leading-relaxed max-w-xl"
      mediaClassName="w-full"
    >
      <SocialLinks slot="social" links={socialLinks} />
      <FilmDistortionImage
        client:visible
        src={headshot.src}
        alt="Portrait of Simon Bremner"
        className="block w-full h-auto"
        width={headshot.width}
        height={headshot.height}
      />
    </AnimatedHero>
  </Container>

  {/* Equipment Section */}
  {
    (cameras.length > 0 || lenses.length > 0 || softwareItems.length > 0) && (
      <Container className="py-16 lg:py-24">
        <EquipmentSection
          cameras={cameras}
          lenses={lenses}
          softwareItems={softwareItems}
        />
      </Container>
    )
  }
</PageLayout>
