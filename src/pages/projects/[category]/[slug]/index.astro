---
// src/pages/photography/[slug].astro
import Container from "@/components/main/Container.astro";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { client, fetchProjectById, urlForImage } from "@/lib/sanity";
import ScrollIndicator from "@/components/motion/ScrollIndicator";

// Import the content blocks
import { ContentRenderer } from "@/components/blocks/ContentRenderer";
import HeroSection from "@/components/blocks/HeroSection.astro";
import { AuthorSection } from "@/components/blocks/AuthorSection";
import { ArrowLeft } from "lucide-react";
import { Separator } from "@/components/ui/separator";
import PageLayout from "@/layouts/PageLayout.astro";

// Define all possible paths for pre-rendering at build time
export async function getStaticPaths() {
  // Get all photography posts from Sanity
  const postCategories = await client.fetch(`
    *[_type in ["photography", "design", "development", "handcrafted"]]{
      "slug": slug.current,
      "category": _type,
      _id
    }
  `);

  // Create paths for photography posts
  return postCategories?.map((post: { category: string; slug: string }) => ({
    params: {
      category: post?.category,
      slug: post?.slug,
    },
    props: {
      category: post?.category,
    },
  }));
}

// Get the slug from the URL
const { slug } = Astro.params;
const { category } = Astro.props;

// Fetch the complete photography post by ID with expanded references
const postData = await fetchProjectById(category, slug);

// Format the date for display
const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const publishedDate = formatDate(postData?.publishedAt);

if (!postData) {
  return Astro.redirect("/404");
}

const mainImage = postData?.mainImage;
const mainImageCaption = mainImage?.caption;
const mainImageAlt = mainImage?.alt;
const mainImageUrl = urlForImage(mainImage).url();
---

<PageLayout
  title={postData.title}
  description={postData.excerpt}
  image={mainImageUrl}
  pageType="article">
  <ScrollIndicator client:load>
    <article>
      <HeroSection
        title={postData.title}
        mainImage={mainImageUrl}
        mainImageAlt={mainImageAlt}
        mainImageCaption={mainImageCaption}
        shootMetadata={postData.shootMetadata}
      />

      <Container>
        <div class="max-w-4xl mx-auto">
          <AuthorSection
            author={postData.author}
            publishedDate={publishedDate}
            excerpt={postData.excerpt}
            urlForImage={urlForImage}
          />
          <Separator className="my-8" />

          <!-- Content Blocks rendered using our ContentRenderer component -->
          {
            postData.content && postData.content.length > 0 && (
              <div class="mb-16">
                <ContentRenderer client:load blocks={postData.content} />
              </div>
            )
          }
          <!-- Tags -->
          {
            postData.tags && postData.tags.length > 0 && (
              <div class="mb-12">
                <h3 class="text-lg font-medium mb-3">Tags</h3>
                <div class="flex flex-wrap gap-2">
                  {postData.tags.map((tag: string) => (
                    <Badge variant="outline">{tag}</Badge>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Back Button -->
          <div class="mt-12 mb-24">
            <a href={`/projects/${category}`}>
              <Button variant="outline" className="gap-2 cursor-pointer">
                <ArrowLeft />
                Back to {category}
              </Button>
            </a>
          </div>
        </div>
      </Container>
    </article>
  </ScrollIndicator>
</PageLayout>
