---
// src/pages/photography/[slug].astro
import Layout from "@/layouts/Layout.astro";
import { Container } from "@/components/main/Container";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { client, fetchProjectById, urlForImage } from "@/lib/sanity";

// Import the content blocks
import ContentRenderer from "@/components/blocks/ContentRenderer";

// Define all possible paths for pre-rendering at build time
export async function getStaticPaths() {
  // Get all photography posts from Sanity
  const postCategories = await client.fetch(`
    *[_type in ["photography", "design", "development", "handcrafted"]]{
      "slug": slug.current,
      "category": _type,
      _id
    }
  `);

  // Create paths for photography posts
  return postCategories?.map((post: { category: string; slug: string }) => ({
    params: {
      category: post?.category,
      slug: post?.slug,
    },
    props: {
      category: post?.category,
    },
  }));
}

// Get the slug from the URL
const { slug } = Astro.params;
const { category } = Astro.props;

// Fetch the complete photography post by ID with expanded references
const postData = await fetchProjectById(category, slug);

// Format the date for display
const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
};

const publishedDate = formatDate(postData?.publishedAt);

// 404 handling if content not found
// if (!postData) {
//   return Astro.redirect("/404");
// }
// console.log(postData);
---

<Layout title={postData.title} description={postData.excerpt}>
  <article class="photography-article">
    <!-- Hero Section -->
    <div class="relative h-[70vh] mb-16">
      {/* Background image */}
      <div class="absolute inset-0">
        {
          postData.mainImage && (
            <img
              src={urlForImage(postData.mainImage).url()}
              alt={postData.mainImage.alt || postData.title}
              class="w-full h-full object-cover opacity-90"
            />
          )
        }
        {/* Dark gradient overlay for text visibility */}
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"
        >
        </div>
      </div>

      {/* Text container - explicitly positioned at bottom */}
      <div class="absolute inset-x-0 bottom-0 pb-8 pt-16">
        <div class="container max-w-5xl mx-auto px-4">
          <div class="flex items-center mb-4">
            <!-- <Badge
              variant="outline"
              className="bg-primary/80 text-white border-primary/30 hover:bg-primary/90"
            >
              Photography
            </Badge> -->
            {
              postData.shootMetadata?.theme && (
                <Badge
                  variant="outline"
                  className="bg-primary/80 text-white border-primary/30 hover:bg-primary/90 ml-2"
                >
                  {postData.shootMetadata.theme}
                </Badge>
              )
            }
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white">
            {postData.title}
          </h1>
          {
            postData.mainImage?.caption && (
              <p class="text-xl text-white/90 max-w-3xl">
                {postData.mainImage.caption}
              </p>
            )
          }
        </div>
      </div>
    </div>

    <Container>
      <div class="max-w-4xl mx-auto">
        <!-- Article Header -->
        <div class="mb-16">
          {
            postData.author && (
              <div class="flex items-center mb-6">
                {postData.author.image && (
                  <div class="w-10 h-10 rounded-full overflow-hidden mr-3">
                    <img
                      src={urlForImage(postData.author.image)
                        .width(80)
                        .height(80)
                        .url()}
                      alt={postData.author.name}
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <div>
                  <div class="text-sm text-muted-foreground">
                    By <span class="font-medium">{postData.author.name}</span>
                  </div>
                  <div class="text-sm text-muted-foreground">
                    {publishedDate}
                  </div>
                </div>
              </div>
            )
          }

          {
            postData.excerpt && (
              <div class="text-xl font-medium italic mb-8 text-muted-foreground border-l-4 pl-4 border-primary">
                {postData.excerpt}
              </div>
            )
          }
        </div>

        <!-- Photography Metadata -->
        <div class="mb-12 space-y-6">
          <!-- Location if available -->
          {
            postData.location && (
              <div class="bg-muted p-4 rounded-lg">
                <h3 class="text-lg font-semibold mb-2">Location</h3>
                <p>
                  {[
                    postData.location.name,
                    postData.location.city,
                    postData.location.country,
                  ]
                    .filter(Boolean)
                    .join(", ")}
                </p>
              </div>
            )
          }

          <!-- Equipment used -->
          {
            (postData.shootMetadata?.equipment?.cameras?.length > 0 ||
              postData.shootMetadata?.equipment?.lenses?.length > 0) && (
              <div class="bg-muted p-4 rounded-lg">
                <h3 class="text-lg font-semibold mb-3">Equipment Used</h3>

                {postData.shootMetadata.equipment.cameras?.length > 0 && (
                  <div class="mb-4">
                    <h4 class="font-medium mb-2">Cameras</h4>
                    <ul class="list-disc pl-5 space-y-1">
                      {postData.shootMetadata.equipment.cameras?.map(
                        (camera: { brand: string; name: string; type?: string }) => (
                          <li>
                            {camera.brand} {camera.name}
                            {camera.type && (
                              <span class="text-muted-foreground">
                                {" "}
                                ({camera.type})
                              </span>
                            )}
                          </li>
                        ),
                      )}
                    </ul>
                  </div>
                )}

                {postData.shootMetadata.equipment.lenses?.length > 0 && (
                  <div>
                    <h4 class="font-medium mb-2">Lenses</h4>
                    <ul class="list-disc pl-5 space-y-1">
                      {postData.shootMetadata.equipment.lenses?.map((lens: { brand: string; name: string; focalLength?: { min: number; max: number } }) => (
                        <li>
                          {lens.brand} {lens.name}
                          {lens.focalLength && (
                            <span class="text-muted-foreground">
                              {" "}
                              (
                              {lens.focalLength.min === lens.focalLength.max
                                ? `${lens.focalLength.min}mm`
                                : `${lens.focalLength.min}-${lens.focalLength.max}mm`}
                              )
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )
          }

          <!-- Technical notes if available -->
          {
            postData.shootMetadata?.technicalNotes && (
              <div class="bg-muted p-4 rounded-lg">
                <h3 class="text-lg font-semibold mb-2">Technical Notes</h3>
                <p>{postData.shootMetadata.technicalNotes}</p>
              </div>
            )
          }
        </div>

        <!-- Content Blocks rendered using our ContentRenderer component -->
        {
          postData.content && postData.content.length > 0 && (
            <div class="mb-16">
              <ContentRenderer client:load blocks={postData.content} />
            </div>
          )
        }

        <!-- Tags -->
        {
          postData.tags && postData.tags.length > 0 && (
            <div class="mb-12">
              <h3 class="text-lg font-medium mb-3">Tags</h3>
              <div class="flex flex-wrap gap-2">
                {postData.tags.map((tag: string) => (
                  <Badge variant="outline">{tag}</Badge>
                ))}
              </div>
            </div>
          )
        }

        <!-- Back Button -->
        <div class="mt-12 mb-24">
          <a href={`/projects/${category}`}>
            <Button variant="outline" className="gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mr-1"
              >
                <path d="m12 19-7-7 7-7"></path>
                <path d="M19 12H5"></path>
              </svg>
              Back to {category}
            </Button>
          </a>
        </div>
      </div>
    </Container>
  </article>
</Layout>
