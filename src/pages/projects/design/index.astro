---
// src/pages/projects/design.astro (copy this pattern for other categories)
import Layout from "@/layouts/Layout.astro";
import ProjectsGrid from "@/components/main/ProjectsGrid";
import { projects } from "@/data/projects";

// Get current path
const currentPath = Astro.url.pathname;

// Format category name from the URL
const categorySlug = currentPath.split("/").pop() || "";
const categoryName =
    categorySlug.charAt(0).toUpperCase() + categorySlug.slice(1);

// Filter projects for this specific category
const categoryProjects = projects.filter(
    (project) => project.category.toLowerCase() === categoryName.toLowerCase(),
);

// Page metadata
const pageTitle = `${categoryName} Projects`;
const pageDescription = `Browse our portfolio of ${categoryName.toLowerCase()} projects`;
---

<Layout title={pageTitle} description={pageDescription}>
    <ProjectsGrid
        allProjects={categoryProjects}
        title={`${categoryName} Projects`}
        subtitle={`Our ${categoryName.toLowerCase()} portfolio`}
        currentPath={currentPath}
        hideTabsOnSubPages={true}
        client:load
    />
</Layout>
