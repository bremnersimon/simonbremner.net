---
// src/pages/projects/development.astro
import Layout from "@/layouts/Layout.astro";
import ProjectsGrid from "@/components/main/ProjectsGrid";
import { projects } from "@/data/projects";

// Get current path
const currentPath = Astro.url.pathname;

// Category specific data
const categoryName = "Development";

// Filter projects for this category
const categoryProjects = projects.filter(
    (project) => project.category === categoryName,
);

// Page metadata
const pageTitle = "Development Projects";
const pageDescription =
    "Explore our web and app development projects showcasing innovative solutions";
---

<Layout title={pageTitle} description={pageDescription}>
    <ProjectsGrid
        allProjects={categoryProjects}
        title={`${categoryName} Projects`}
        subtitle={`Our ${categoryName.toLowerCase()} portfolio`}
        currentPath={currentPath}
        hideTabsOnSubPages={true}
        client:load
    />
</Layout>
