---
import "../styles/global.css";
import "highlight.js/styles/github-dark.css";
import { Navbar } from "../components/globals/Navbar";
import CommonHead from "../lib/CommonHead.astro";
import Footer from "@/components/globals/Footer.astro";
import TagManager from "../lib/TagManager.astro";
import Background from "@/assets/background-lines.svg";
import { Image } from "astro:assets";

const columns = [1, 2, 3];

const year = new Date().getFullYear();
const { title = "Simon Bremner", description = "Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <TagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <CommonHead title={title} description={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="text-foreground bg-background flex flex-col min-h-screen">
    <Navbar client:load />
    <main id="page-content" class="flex-grow">
      <slot />
    </main>
    <Footer title={title} year={year} />
  </body><style>
    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</html>
