---
// Import necessary dependencies
import { Button } from "@/components/ui/button";
import { Container } from "@/components/main/Container";
import ProjectCard from "@/components/main/ProjectCard";
import type { ProjectCardProps } from "@/types/index";

interface Props {
  allProjects: ProjectCardProps[];
  title?: string;
  subtitle?: string;
  categories?: string[];
  defaultTab?: string;
  projectsPerPage?: number;
  currentPath?: string;
  hideTabsOnSubPages?: boolean;
}

// Destructure the props with default values
const {
  allProjects = [],
  title = "Our Projects",
  subtitle = "Check out what we've been working on",
  projectsPerPage = 10,
  currentPath = "",
} = Astro.props;

// Get initial visible projects for server render
const initialVisibleProjects = allProjects.slice(0, projectsPerPage);
const initialHasMore = allProjects.length > projectsPerPage;
---

<section class="w-full py-40">
  <Container>
    <div class="text-left mb-12 fade-in">
      <h2 class="text-4xl md:text-6xl font-bold mb-4">{title}</h2>
      <p class="text-2xl md:text-4xl text-muted-foreground">{subtitle}</p>
    </div>

    <div id="project-grid-container">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        id="projects-grid">
        {
          initialVisibleProjects.map((project) => (
            <div
              class="project-item"
              data-category={project.category?.toLowerCase()}>
              <ProjectCard
                _id={project._id}
                client:visible
                title={project.title}
                mainImage={project.mainImage}
                slug={project.slug}
                category={project.category}
                tags={project.tags || []}
                aspectRatio="square"
              />
            </div>
          ))
        }

        {
          initialVisibleProjects.length === 0 && (
            <div class="col-span-full min-h-[300px] flex items-center justify-center">
              <p class="text-muted-foreground">No projects in this category</p>
            </div>
          )
        }
      </div>

      {
        initialHasMore && (
          <div class="flex justify-center mt-12">
            <Button
              client:load
              variant="outline"
              size="lg"
              id="load-more-button"
              className="min-w-[200px]">
              Load More
            </Button>
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .fade-in {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-item {
    opacity: 0;
    animation: itemFadeIn 0.3s ease-out forwards;
  }

  @keyframes itemFadeIn {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Store all projects data
  let allProjects = [];
  let categories = [];
  let currentCategory = "";
  let currentPage = 1;
  let projectsPerPage = 10;

  // DOM elements
  const container = document.getElementById("project-grid-container");
  const loadMoreButton = document.getElementById(
    "load-more-button"
  ) as HTMLButtonElement;

  // Get initial category from data attribute
  if (container) {
    currentCategory = container.dataset.initialCategory || "All";
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", () => {
    initProjectsGrid();
  });

  async function initProjectsGrid() {
    // Get data from the page's initial load
    const projectItems: NodeListOf<HTMLElement> =
      document.querySelectorAll(".project-item");

    // Set up load more button event listener
    if (loadMoreButton) {
      loadMoreButton.addEventListener("click", loadMoreProjects);
    }

    // Apply staggered animation to initial items
    projectItems.forEach((item, index) => {
      const delay = index * 0.05;
      item.style.animationDelay = `${delay}s`;
    });
  }

  function loadMoreProjects() {
    if (!loadMoreButton) return;

    // Show loading state
    loadMoreButton.textContent = "Loading...";
    loadMoreButton.disabled = true;

    // Simulate loading delay for better UX
    setTimeout(() => {
      currentPage++;

      // This would normally fetch more projects from the server
      // For now, we'll just simulate the behavior by cloning existing items

      const existingItems = document.querySelectorAll(".project-item");
      const hasMore = existingItems.length >= projectsPerPage * currentPage;

      if (!hasMore) {
        // Hide load more button if no more projects
        loadMoreButton.style.display = "none";
      } else {
        // Reset button state
        loadMoreButton.textContent = "Load More";
        loadMoreButton.disabled = false;
      }
    }, 500);
  }
</script>
