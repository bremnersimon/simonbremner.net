---
// Import necessary dependencies
import { Button } from "@/components/ui/button";
import Container from "@/components/main/Container.astro";
import ProjectCard from "@/components/main/ProjectCard";
import type { ProjectCardProps } from "@/types/index";

interface Props {
  allProjects: ProjectCardProps[];
  title?: string;
  subtitle?: string;
  categories?: string[];
  defaultTab?: string;
  projectsPerPage?: number;
  hideTabsOnSubPages?: boolean;
}

// Destructure the props with default values
const {
  allProjects = [],
  title = "My Projects",
  subtitle = "Check out what I've been working on",
  projectsPerPage = 10,
} = Astro.props;

// Get initial visible projects for server render
const initialVisibleProjects = allProjects.slice(0, projectsPerPage);
const initialHasMore = allProjects.length > projectsPerPage;
---

<section class="w-full py-20 md:py-40">
  <Container>
    <div class="text-left mb-12">
      <h2 class="text-4xl md:text-6xl font-bold mb-4">{title}</h2>
      <p class="text-lg md:text-2xl text-muted-foreground">{subtitle}</p>
    </div>

    <div id="project-grid-container">
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
        id="projects-grid">
        {
          initialVisibleProjects.map((project) => (
            <div
              class="project-item opacity-0"
              data-category={project.category?.toLowerCase()}>
              <ProjectCard
                _id={project._id}
                client:visible
                title={project.title}
                mainImage={project.mainImage}
                slug={project.slug}
                category={project.category}
                tags={project.tags || []}
                aspectRatio="square"
              />
            </div>
          ))
        }

        {
          initialVisibleProjects.length === 0 && (
            <div class="col-span-full min-h-[300px] flex items-center justify-center">
              <p class="text-muted-foreground">No projects in this category</p>
            </div>
          )
        }
      </div>

      {
        initialHasMore && (
          <div class="flex justify-center mt-12">
            <Button
              variant="outline"
              size="lg"
              id="load-more-button"
              className="min-w-[200px]">
              Load More
            </Button>
          </div>
        )
      }
    </div>
  </Container>
</section>

<script>
  import { animate, stagger } from "motion";

  // Store all projects data
  let allProjects = [];
  let categories = [];
  let currentCategory = "";
  let currentPage = 1;
  let projectsPerPage = 10;

  // DOM elements
  const container = document.getElementById("project-grid-container");
  const loadMoreButton = document.getElementById(
    "load-more-button"
  ) as HTMLButtonElement;

  // Get initial category from data attribute
  if (container) {
    currentCategory = container.dataset.initialCategory || "All";
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", () => {
    initProjectsGrid();
  });

  function initProjectsGrid() {
    // Animate the project items with stagger effect
    const projectItems = document.querySelectorAll(".project-item");
    animate(
      projectItems,
      {
        // @ts-ignore
        opacity: [0, 1],
        y: [50, 0],
        scale: [0.9, 1],
      },
      {
        delay: stagger(0.07),
        duration: 0.5,
        easing: [0.25, 0.1, 0.25, 1],
      }
    );

    // Set up load more button event listener
    if (loadMoreButton) {
      loadMoreButton.addEventListener("click", loadMoreProjects);
    }
  }

  function loadMoreProjects() {
    if (!loadMoreButton) return;

    // Show loading state
    loadMoreButton.textContent = "Loading...";
    loadMoreButton.disabled = true;

    // Simulate loading delay for better UX
    setTimeout(() => {
      currentPage++;

      // This would normally fetch more projects from the server
      // For now, we'll simulate the behavior by cloning existing items
      const projectsGrid = document.getElementById("projects-grid");
      const existingItems = document.querySelectorAll(".project-item");

      // Clone some existing items (in a real app, this would be new data)
      const newItems = [];

      // Calculate how many new items to add
      const itemsToAdd = Math.min(projectsPerPage, existingItems.length);

      for (let i = 0; i < itemsToAdd; i++) {
        // Clone an existing item
        const randomIndex = Math.floor(Math.random() * existingItems.length);
        const clonedItem = existingItems[randomIndex].cloneNode(
          true
        ) as HTMLElement;

        // Set initial state for animation
        clonedItem.style.opacity = "0";
        clonedItem.style.transform = "translateY(50px)";

        // Add to DOM
        projectsGrid?.appendChild(clonedItem);
        newItems.push(clonedItem);
      }

      // Animate the new items with stagger
      if (newItems.length > 0) {
        animate(
          newItems,
          {
            // @ts-ignore
            opacity: [0, 1],
            y: [50, 0],
            scale: [0.9, 1],
          },
          {
            delay: stagger(0.07),
            duration: 0.5,
            easing: [0.25, 0.1, 0.25, 1],
          }
        );
      }

      const hasMore =
        existingItems.length + newItems.length < allProjects.length;

      if (!hasMore) {
        // Hide load more button if no more projects
        loadMoreButton.style.display = "none";
      } else {
        // Reset button state
        loadMoreButton.textContent = "Load More";
        loadMoreButton.disabled = false;
      }
    }, 500);
  }
</script>
