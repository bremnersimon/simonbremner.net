---
import Layout from "./Layout.astro";
import ProjectsGrid from "@/components/main/ProjectsGrid";
import { projects } from "@/data/projects";

// Define props with defaults
interface Props {
    categoryName: string;
    title?: string;
    subtitle?: string;
    customProjects?: any[];
    categories?: string[];
    hideTabsOnSubPages?: boolean;
    metaTitle?: string;
    metaDescription?: string;
}

// Get props with defaults
const {
    categoryName,
    title = `${categoryName} Projects`,
    subtitle = `Our ${categoryName.toLowerCase()} portfolio`,
    customProjects = null,
    categories = ["All", "Photography", "Design", "Development", "Handcrafted"],
    hideTabsOnSubPages = true,
    metaTitle = title,
    metaDescription = subtitle,
} = Astro.props;

// Get current path for active tab highlighting
const currentPath = Astro.url.pathname;

// Filter projects for this category - use customProjects if provided, otherwise filter from all projects
const categoryProjects =
    customProjects ||
    projects.filter(
        (project) =>
            project.category.toLowerCase() === categoryName.toLowerCase(),
    );
---

<Layout title={metaTitle} description={metaDescription}>
    <ProjectsGrid
        allProjects={categoryProjects}
        title={title}
        subtitle={subtitle}
        categories={categories}
        currentPath={currentPath}
        hideTabsOnSubPages={hideTabsOnSubPages}
        client:load
    />

    <slot />
</Layout>
