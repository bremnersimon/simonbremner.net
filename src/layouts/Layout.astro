---
import "@/styles/global.css";
import { Navbar } from "../components/globals/Navbar";
import CommonHead from "../lib/CommonHead.astro";
import Footer from "@/components/globals/Footer";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<CommonHead
			title="Simon Bremner"
			description="I'm a creative, I think..."
		/>
	</head>
	<body class="bg-background text-foreground pt-20">
		<Navbar client:load transition:persist />
		<main id="container">
			<slot />
		</main>
		<Footer
			title="Simon Bremner"
			sections={[
				{
					title: "Pages",
					links: [
						{ title: "Home", href: "/" },
						{ title: "About", href: "/about" },
						{ title: "Contact", href: "/contact" },
					],
				},
				{
					title: "Projects",
					links: [
						{ title: "Photography", href: "/projects/photography" },
						{ title: "Design", href: "/projects/design" },
						{ title: "Development", href: "/projects/development" },
						{ title: "Handcrafted", href: "/projects/handcrafted" },
					],
				},
				{
					title: "Legal",
					links: [
						{ title: "Privacy", href: "/privacy" },
						{ title: "Terms", href: "/terms" },
						{ title: "Contact", href: "/contact" },
					],
				},
			]}
		/>
	</body>
</html>

<style>
	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

	#container {
		font-family: Inter, Roboto, "Helvetica Neue", "Arial Nova",
			"Nimbus Sans", Arial, sans-serif;
		height: 100%;
		min-height: 100vh;
	}
</style>
