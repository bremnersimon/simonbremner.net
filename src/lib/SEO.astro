---
import { getImage } from "astro:assets";
// Import default images
import defaultOgImage from "@/assets/main-og-image.jpg";
import type { SEOProps } from "@/types/types";

type Props = SEOProps;

// Default values that can be overridden by props
const SITE_NAME = "Portfolio | Simon Bremner";
const DEFAULT_DESCRIPTION = "A Creative Portfolio";

// Destructure props with defaults
const {
  title,
  description = DEFAULT_DESCRIPTION,
  pageType = "website",
  image,
  noindex = false,
  nofollow = false,
  article,
} = Astro.props;
// Process the OG image
let ogImage: string;
const baseUrl =
  import.meta.env.MODE === "development"
    ? "http://localhost:4321"
    : import.meta.env.SITE;

if (image) {
  // Case 1: Image is a string (URL/path)
  if (typeof image === "string") {
    // If it's already a full URL, use it directly
    if (image.startsWith("http")) {
      ogImage = image;
    } else {
      // Otherwise, it's a relative path, prepend the site URL
      ogImage = new URL(image, baseUrl).toString();
    }
  }
  // Case 2: Image is an imported asset
  else {
    const processedImage = await getImage({
      src: image,
      width: 1200,
      height: 630,
      format: "jpg",
    });
    ogImage = new URL(processedImage.src, baseUrl).toString();
  }
}
// Case 3: No image provided, use default
else {
  const processedDefaultImage = await getImage({
    src: defaultOgImage,
    width: 1200,
    height: 630,
    format: "jpg",
  });
  ogImage = new URL(processedDefaultImage.src, baseUrl).toString();
}
// Create full canonical URL
const canonicalURL = Astro.url.href;
// Handle robots directives for noindex/nofollow
const robotsDirectives = [];
if (noindex) robotsDirectives.push("noindex");
if (nofollow) robotsDirectives.push("nofollow");
const robotsContent =
  robotsDirectives.length > 0 ? robotsDirectives.join(", ") : "index, follow";
---

<!-- Basic meta tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Simon Bremner" />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robotsContent} />

<!-- Open Graph meta tags for Facebook, LinkedIn, etc. -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={pageType} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card meta tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Article specific tags (only for articles) -->
{
  pageType === "article" && article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  pageType === "article" && article?.modifiedTime && (
    <meta property="article:modified_time" content={article.modifiedTime} />
  )
}
{
  pageType === "article" && article?.author && (
    <meta property="article:author" content={article.author} />
  )
}
{
  pageType === "article" &&
    article?.tags &&
    article.tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- Apple specific tags -->
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
