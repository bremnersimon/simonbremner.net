---
import type { SocialLink } from "@/lib/sanity";
import { cn } from "@/lib/utils";

interface Props {
    link: SocialLink;
    label?: string;
    iconSize?: number;
    class?: string;
}

const {
    link,
    label = link.label,
    iconSize = 20,
    class: className,
} = Astro.props;
---

<a
    href={link.href}
    target={link.isExternal ? "_blank" : undefined}
    rel={link.isExternal ? "noopener noreferrer" : undefined}
    class={cn(
        "inline-flex min-h-8 items-center gap-3 text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
        className,
    )}
>
    <img
        src={link.iconUrl}
        alt=""
        aria-hidden="true"
        width={iconSize}
        height={iconSize}
        loading="lazy"
        decoding="async"
        class="shrink-0 object-contain"
        style={`width:${iconSize}px;height:${iconSize}px`}
    />
    <span>{label}</span>
</a>
