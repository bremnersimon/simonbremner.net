---
import Container from "@/components/main/Container.astro";
import { Button } from "@/components/shad-ui/button";
import { Icon } from "./Icon";
import HoverImageLink from "./HoverImageLink";

// Import images for hover effects
import designImage from "@/assets/brave-baby-poster.jpg";
import photographyImage from "@/assets/catawba-river.jpg";
import handcraftedImage from "@/assets/bc-tea-tree.jpg";
import developmentImage from "@/assets/sb-code.jpg";

type Cta = {
  text: string;
  href: string;
  icon?: string;
};
const { primaryCta, secondaryCta } = Astro.props as {
  primaryCta: Cta;
  secondaryCta: Cta;
};
---

<Container>
  <div
    class="flex flex-col items-start justify-center text-left w-full h-full pt-10 md:pt-40 max-w-5xl px-4 lg:px-0"
  >
    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-relaxed leading-tight"
    >
      Hello, my name is <a
        href="/about"
        class="underline hover:text-primary transition-colors relative group"
      >
        Simon Bremner
      </a>.
      <br />
      A
      <HoverImageLink
        client:load
        href="/projects/design"
        imageSrc={designImage.src}
        imageAlt="Design projects preview"
        className="underline hover:text-primary transition-colors"
      >
        Designer
      </HoverImageLink>,
      <HoverImageLink
        client:load
        href="/projects/development"
        imageSrc={developmentImage.src}
        imageAlt="Development projects preview"
        className="underline hover:text-primary transition-colors"
      >
        Developer
      </HoverImageLink>,
      <HoverImageLink
        client:load
        href="/projects/photography"
        imageSrc={photographyImage.src}
        imageAlt="Photography projects preview"
        className="underline hover:text-primary transition-colors"
      >
        Photographer
      </HoverImageLink>, and Maker of <HoverImageLink
        client:load
        href="/projects/handcrafted"
        imageSrc={handcraftedImage.src}
        imageAlt="Handcrafted products preview"
        className="underline hover:text-primary transition-colors"
      >
        Handcrafted Products
      </HoverImageLink>
    </h1>
    <div class="flex flex-col sm:flex-row gap-4 mt-10">
      {
        primaryCta && (
          <a href={primaryCta.href} data-astro-reload>
            <Button className="cursor-pointer" variant="default" size="lg">
              {primaryCta.text}
              {primaryCta?.icon && <Icon name={primaryCta.icon} size={24} />}
            </Button>
          </a>
        )
      }
      {
        secondaryCta && (
          <a href={secondaryCta.href} data-astro-reload>
            <Button className="cursor-pointer" variant="outline" size="lg">
              {secondaryCta.text}
              {secondaryCta?.icon && (
                <Icon name={secondaryCta.icon} size={24} />
              )}
            </Button>
          </a>
        )
      }
    </div>
  </div>
</Container>
