---
import { Image } from "astro:assets";
import BcTeaTree from "@/assets/bc-tea-tree.jpg";
import BooneVista from "@/assets/boone-vista.jpg";
import CK from "@/assets/c-k.jpg";
import CatawbaKayak from "@/assets/catawba-kayak.jpg";
import CatawbaRiver from "@/assets/catawba-river.jpg";
import PineappleFountain from "@/assets/pineapple-fountain.jpg";
import RavanelBridge from "@/assets/ravanel-bridge.jpg";
const images = [
	{ image: CK },
	{ image: BcTeaTree },
	{ image: PineappleFountain },
	{ image: CatawbaKayak },
	{ image: CatawbaRiver },
	{ image: BooneVista },
	{ image: RavanelBridge },
];
---

<section class="hidden lg:block h-[200vh] relative img-group-container">
  <div class="sticky top-0 overflow-hidden">
    <ul class="flex img-group">
      <li class="w-[300vw] h-screen flex-none img-container">
        <div class="flex flex-row h-full w-full items-center justify-center">
          <div
            class="image-item pointer-events-none object-cover aspect-[3/4] w-1/9">
          </div>
          {
            images.map((item, index) => (
              <Image
                class="image-item pointer-events-none object-cover aspect-[3/4] w-1/9 rounded-md"
                src={item.image}
                alt={`Image ${index + 1}`}
                format="webp"
              />
            ))
          }
          <div
            class="image-item pointer-events-none object-cover aspect-[3/4] w-1/9">
          </div>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Initial styles for images */
  .image-item {
    opacity: 0.2; /* Start with low opacity */
    transform: translateY(0px) scale(0.8); /* Start with smaller scale */
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
  }
</style>

<script>
  import { animate, scroll } from "motion";

  document.addEventListener("astro:page-load", () => {
    // Select all image elements
    const imageItems = document.querySelectorAll(".image-item");

    // No need to set transition property here since we do it in CSS

    // Calculate center position
    const calculateCenter = () => {
      return window.innerWidth / 2;
    };

    // Track scroll position and update opacities
    const updateOpacities = () => {
      const centerX = calculateCenter();

      imageItems.forEach((img) => {
        const rect = img.getBoundingClientRect();
        const imgCenterX = rect.left + rect.width / 2;

        // Calculate distance from center (normalized to 0-1 range)
        const distanceFromCenter = Math.abs(imgCenterX - centerX);
        const maxDistance = window.innerWidth / 2;
        const normalizedDistance = Math.min(
          distanceFromCenter / maxDistance,
          1
        );

        // Opacity formula: closer to center = more visible
        const opacity = 0 + 1 * (1 - normalizedDistance);
        const scale = 0.8 + 0.2 * (1 - normalizedDistance);
        const yOffset = -50 * (1 - normalizedDistance);

        // Apply styles
        (img as HTMLElement).style.transform =
          `translateY(${yOffset}px) scale(${scale})`;
        (img as HTMLElement).style.opacity = opacity.toString();
      });
    };

    scroll(
      animate(".img-group", {
        transform: ["none", "translateX(-200vw)"],
      }),
      { target: document.querySelector(".img-group-container") || undefined }
    );

    // Add scroll event listener to update opacities during scroll
    const imgGroupContainer = document.querySelector(".img-group-container");
    if (imgGroupContainer) {
      imgGroupContainer.addEventListener("scroll", updateOpacities);

      // Use MutationObserver to detect scroll position changes from animations
      const observer = new MutationObserver(updateOpacities);
      observer.observe(imgGroupContainer, {
        attributes: true,
        attributeFilter: ["style"],
      });

      // Also use requestAnimationFrame for smoother updates
      function animate() {
        updateOpacities();
        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);
    }

    // Initial update and resize handling
    // Small delay to ensure initial styles are applied properly
    setTimeout(() => {
      updateOpacities();
    }, 100);
    window.addEventListener("resize", updateOpacities);
  });
</script>
