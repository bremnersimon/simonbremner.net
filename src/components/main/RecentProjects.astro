---
import Container from "@/components/main/Container.astro";
import ProjectCard from "@/components/main/ProjectCard.astro";
import { urlForImage } from "@/lib/sanity";
import type { ProjectCardProps } from "@/types";

interface Props {
  featuredProjects: ProjectCardProps[];
  title?: string;
  subtitle?: string;
}

const { featuredProjects, title, subtitle } = Astro.props;

const projects = featuredProjects.map((post) => ({
  _id: post._id,
  title: post.title,
  slug: post.slug,
  mainImage: {
    src: post.mainImage
      ? urlForImage(post.mainImage).format("webp").width(700).url()
      : "/images/no-image.svg",
    alt: post.title,
  },
  caption: post.caption,
  category: post.category
    ? post.category.charAt(0).toUpperCase() + post.category.slice(1)
    : "",
  tags: post.tags || [],
  publishedAt: post.publishedAt,
}));
---

<Container>
  <div class="text-left mb-12">
    <h2 class="text-4xl md:text-6xl font-bold mb-4">{title}</h2>
    {
      subtitle && (
        <p class="text-2xl md:text-4xl text-muted-foreground">{subtitle}</p>
      )
    }
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
    {
      projects?.map((project, index) => (
        <div class="project-card-wrapper opacity-0" data-index={index}>
          <ProjectCard
            key={project._id}
            _id={project._id}
            title={project.title}
            mainImage={project.mainImage}
            slug={project.slug}
            category={project.category}
            tags={project.tags}
            aspectRatio="square"
          />
        </div>
      ))
    }
  </div>
</Container>

<script>
  import { inView } from "motion";

  document.addEventListener("astro:page-load", () => {
    const cardWrappers: NodeListOf<HTMLElement> = document.querySelectorAll(
      ".project-card-wrapper"
    );

    cardWrappers.forEach((wrapper) => {
      // @ts-ignore
      inView(wrapper, () => {
        const index = parseInt(wrapper.getAttribute("data-index") || "0");
        wrapper.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
        wrapper.style.opacity = "1";
        wrapper.style.transform = "translateY(0)";

        // Return false to observe only once
        return false;
      });
    });
  });
</script>
