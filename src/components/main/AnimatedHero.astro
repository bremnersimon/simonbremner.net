---
type AnimatedHeroProps = {
    headline: string;
    paragraphs?: string[];
    ariaLabel?: string;
    uppercase?: boolean;
    noWrap?: boolean;
    containerClassName?: string;
    textContainerClassName?: string;
    headlineClassName?: string;
    paragraphClassName?: string;
    mediaClassName?: string;
};

const {
    headline,
    paragraphs = [],
    ariaLabel,
    uppercase = false,
    noWrap = false,
    containerClassName = "",
    textContainerClassName = "",
    headlineClassName = "",
    paragraphClassName = "",
    mediaClassName = "",
} = Astro.props as AnimatedHeroProps;

const headlineCharacters = [...headline].map((char, index) => ({
    char,
    index,
    isSpace: char === " ",
}));
const staggerableIndices = headlineCharacters
    .filter((item) => !item.isSpace)
    .map((item) => item.index);
const staggerOrder = [...staggerableIndices].sort((a, b) => {
    const hashA = (Math.imul(a + 1, 2654435761) >>> 0) % 104729;
    const hashB = (Math.imul(b + 1, 2654435761) >>> 0) % 104729;
    return hashA - hashB;
});
const staggerLookup = new Map(
    staggerOrder.map((characterIndex, staggerIndex) => [
        characterIndex,
        staggerIndex,
    ]),
);

const headlineClasses = [
    "animated-hero-headline",
    "m-0",
    "inline-block",
    "w-auto",
    "max-w-none",
    uppercase ? "uppercase" : "",
    noWrap ? "whitespace-nowrap" : "",
    headlineClassName,
]
    .filter(Boolean)
    .join(" ");

const textContainerClasses = ["animated-hero-text", textContainerClassName]
    .filter(Boolean)
    .join(" ");

const paragraphClasses = ["animated-hero-paragraph", paragraphClassName]
    .filter(Boolean)
    .join(" ");

const containerClasses = ["animated-hero", containerClassName]
    .filter(Boolean)
    .join(" ");

const hasMedia = Astro.slots.has("default");
const hasSocial = Astro.slots.has("social");
const mediaClasses = ["animated-hero-media", mediaClassName]
    .filter(Boolean)
    .join(" ");
---

<div class={containerClasses} data-animated-hero>
    <h1
        class={headlineClasses}
        aria-label={ariaLabel || headline}
        data-animated-hero-headline
    >
        {
            headlineCharacters.map((item) =>
                item.isSpace ? (
                    <span
                        class="animated-hero-space inline-block"
                        aria-hidden="true"
                    >
                        {item.char}
                    </span>
                ) : (
                    <span
                        class="animated-hero-letter inline-block"
                        aria-hidden="true"
                        style={`--stagger:${staggerLookup.get(item.index) ?? 0};`}
                    >
                        {item.char}
                    </span>
                ),
            )
        }
    </h1>

    <div
        class="grid w-full grid-cols-1 gap-8 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] md:gap-10 mb-10"
    >
        <div class={textContainerClasses}>
            {
                paragraphs.map((paragraph) => (
                    <p class={paragraphClasses}>{paragraph}</p>
                ))
            }
        </div>

        {
            hasSocial && (
                <div class="animated-hero-social">
                    <slot name="social" />
                </div>
            )
        }
    </div>

    {
        hasMedia && (
            <div class={mediaClasses}>
                <slot />
            </div>
        )
    }
</div>

<style>
    .animated-hero-space {
        width: 0.35em;
    }

    .animated-hero-letter {
        opacity: 0;
        transform: translateY(0.52em) scaleY(1);
        transform-origin: 50% 88%;
        transition: transform 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .animated-hero[data-ready="true"] .animated-hero-letter {
        animation: animated-hero-fall-in 650ms cubic-bezier(0.15, 0.8, 0.2, 1)
            both;
        animation-delay: calc(var(--stagger) * 56ms + 110ms);
    }

    .animated-hero[data-ready="true"] .animated-hero-letter:hover {
        transform: translateY(0) scaleY(1.28);
    }

    @keyframes animated-hero-fall-in {
        from {
            opacity: 0;
            transform: translateY(0.52em) scaleY(1);
        }
        to {
            opacity: 1;
            transform: translateY(0) scaleY(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animated-hero-letter {
            opacity: 1;
            transform: none;
            transition: none;
            animation: none !important;
        }

        .animated-hero[data-ready="true"] .animated-hero-letter:hover {
            transform: none;
        }
    }
</style>

<script is:inline>
    (() => {
        const initAnimatedHeroes = () => {
            const heroes = document.querySelectorAll("[data-animated-hero]");
            heroes.forEach((hero) => {
                if (!(hero instanceof HTMLElement)) {
                    return;
                }
                if (hero.dataset.bound === "true") {
                    return;
                }
                hero.dataset.bound = "true";

                const setReady = () => {
                    requestAnimationFrame(() => {
                        hero.dataset.ready = "true";
                    });
                };

                if (document.fonts?.ready) {
                    document.fonts.ready.then(setReady);
                } else {
                    setReady();
                }
            });
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initAnimatedHeroes, {
                once: true,
            });
        } else {
            initAnimatedHeroes();
        }

        const globalWindow = window;
        if (!globalWindow.__animatedHeroPageLoadBound) {
            globalWindow.__animatedHeroPageLoadBound = true;
            document.addEventListener("astro:page-load", initAnimatedHeroes);
        }
    })();
</script>
