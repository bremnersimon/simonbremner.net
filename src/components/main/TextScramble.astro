---
// TextScramble.astro
// This is an Astro component that creates a text scramble effect
// where a random string gradually transforms into a target string.

interface Props {
	text?: string;
	className?: string;
	duration?: number;
	fps?: number;
}

const {
	text = "Hello World",
	className = "",
	duration = 1000,
	fps = 30,
} = Astro.props;
---

<div
  class={`text-scramble inline-block relative cursor-pointer group ${className}`}
  data-text={text}
  data-duration={duration}
  data-fps={fps}>
  <span class="text-scramble-output"></span>
  <div
    class="absolute bottom-[-2px] left-0 w-0 h-[1px] bg-current transition-[width] duration-300 ease-in-out group-hover:w-full">
  </div>
</div>

<script>
  class TextScrambleEffect {
    private element: HTMLElement;
    private finalText: string;
    private output: HTMLElement | null;
    private chars: string;
    private frameRate: number;
    private duration: number;
    private interval: number | null;

    constructor(element: HTMLElement) {
      this.element = element;
      this.finalText = element.getAttribute("data-text") || "";
      this.output = element.querySelector(".text-scramble-output");
      this.chars =
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()";
      this.frameRate = parseInt(element.getAttribute("data-fps") || "30", 10);
      this.duration = parseInt(
        element.getAttribute("data-duration") || "2000",
        10
      );
      this.interval = null;

      // Initialize
      this.init();
    }

    init() {
      if (!this.output) return;

      // Start with the final text (no animation initially)
      this.output.textContent = this.finalText;

      // Set up hover event listeners
      this.element.addEventListener("mouseenter", () => {
        // Reset and animate on hover
        if (this.interval) clearInterval(this.interval);
        this.animate();
      });

      this.element.addEventListener("mouseleave", () => {
        // Stop animation and show final text on mouse leave
        if (this.interval) {
          clearInterval(this.interval);
          this.interval = null;
        }
        if (this.output) this.output.textContent = this.finalText;
      });
    }

    animate() {
      if (!this.output) return;

      // Start with a random string of the same length
      let currentText = "";
      for (let i = 0; i < this.finalText.length; i++) {
        currentText += this.chars.charAt(
          Math.floor(Math.random() * this.chars.length)
        );
      }
      this.output.textContent = currentText;

      // Calculate number of iterations based on duration and frame rate
      const iterations = Math.ceil(this.duration / (1000 / this.frameRate));
      const framesPerChar = Math.ceil(iterations / this.finalText.length);

      let frame = 0;
      let positions = Array(this.finalText.length).fill(0);

      this.interval = window.setInterval(() => {
        // Create a new string with some characters stabilized
        let newText = "";
        let finished = true;

        for (let i = 0; i < this.finalText.length; i++) {
          // If this position is not yet fixed
          if (positions[i] < framesPerChar) {
            finished = false;

            // Chance of fixing a character increases with each iteration
            if (Math.random() < positions[i] / framesPerChar) {
              // Fix this character
              newText += this.finalText[i];
              positions[i] = framesPerChar; // Mark as fixed
            } else {
              // Still scrambled
              newText += this.chars.charAt(
                Math.floor(Math.random() * this.chars.length)
              );
              positions[i]++; // Increment position's iteration count
            }
          } else {
            // This position is already fixed
            newText += this.finalText[i];
          }
        }

        if (this.output) {
          this.output.textContent = newText;
        }

        // If all characters are fixed or we hit the max iterations
        if (finished || frame >= iterations) {
          if (this.interval) clearInterval(this.interval);
          if (this.output) this.output.textContent = this.finalText;
        }

        frame++;
      }, 1000 / this.frameRate);
    }
  }

  // Initialize all text scramble elements on the page
  document.addEventListener("astro:page-load", () => {
    const elements = document.querySelectorAll(".text-scramble");
    elements.forEach((element) => {
      new TextScrambleEffect(element as HTMLElement);
    });
  });
</script>
