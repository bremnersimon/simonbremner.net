---
type AboutHeroProps = {
	content: {
		headline: string;
		paragraphs: string[];
	};
};
const { content } = Astro.props as AboutHeroProps;
---

<div class="flex flex-col items-center justify-center gap-8 py-20">
  <div class="text-center mb-10">
    <h1
      class="text-2xl md:text-4xl lg:text-6xl font-bold text-center md:leading-tight lg:leading-30 relative">
      {content.headline}
    </h1>
    {
      content.paragraphs.map((paragraph) => (
        <p class="text-muted-foreground text-lg md:text-lg lg:text-xl mt-4 leading-relaxed max-w-4xl mx-auto">
          {paragraph}
        </p>
      ))
    }
  </div>

  <div class="relative w-full max-w-4xl">
    <slot />
  </div>
</div>
