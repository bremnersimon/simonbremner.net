---
type AboutHeroProps = {
  content: {
    headline: string;
    paragraphs: string[];
  };
};
const { content } = Astro.props as AboutHeroProps;
---

<div
  class="grid grid-cols-1 lg:grid-cols-2 items-center justify-center gap-0 md:gap-8 py-20">
  <div class="relative pb-10 md:pb-0">
    <div
      class="hidden lg:inline absolute bottom-[-30px] left-10 font-bold text-primary text-7xl z-10">
      | Simon Bremner
    </div>
    <slot />
  </div>

  <div class="text-left mb-10 lg:mb-0">
    <h1
      class="text-4xl md:text-6xl lg:text-8xl font-bold text-left md:leading-tight lg:leading-30 relative">
      {content.headline}
    </h1>
    {
      content.paragraphs.map((paragraph) => (
        <p class="text-muted-foreground text-lg md:text-lg lg:text-xl mt-4 leading-relaxed">
          {paragraph}
        </p>
      ))
    }
  </div>
</div>
