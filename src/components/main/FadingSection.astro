---
import { Button } from "../ui/button";
import { cn } from "@/lib/utils";
import type { FadingSectionProps } from "@/types/types";
import { Icon } from "./Icon";
import { Image } from "astro:assets";
import Link from "./Link.astro";

interface Props {
  sections: FadingSectionProps[];
}

const { sections } = Astro.props;
---

<div class="w-full">
  {
    sections.map((section) => (
      <div class="w-full flex items-center justify-center relative py-20 lg:py-40">
        <div class="max-w-6xl mx-auto px-4 flex flex-col lg:flex-row items-center">
          {/* Image Column */}
          <div
            class={`w-full p-4 ${section.imagePosition === "right" ? "lg:order-2" : "lg:order-1"}`}>
            <div class="rounded-lg shadow-xl relative">
              <div
                class={cn(
                  "absolute top-[-50px] lg:top-[50px] w-[100px] h-[100px] rounded-lg bg-primary flex items-center justify-center z-10 shadow-md text-white",
                  section.imagePosition === "right"
                    ? "right-[50%] translate-x-1/2 lg:translate-x-0 lg:right-[-50px]"
                    : "translate-x-1/2 lg:translate-x-0 right-[50%] lg:left-[-50px]"
                )}>
                <Icon
                  name={section.button.icon ? section.button.icon : ""}
                  size={35}
                />
              </div>
              <Image
                src={section.image}
                alt={section.title}
                class="w-full h-auto object-cover aspect-[4/5]"
              />
            </div>
          </div>

          {/* Text Column */}
          <div
            class={`w-full p-4 ${section.imagePosition === "right" ? "lg:order-1" : "lg:order-2"}`}>
            <div>
              <h2
                class="text-xl md:text-4xl lg:text-5xl text-foreground font-bold mb-6 animate-text"
                data-delay="0.1">
                {section.title}
              </h2>
              <div class="text-foreground-muted animate-text" data-delay="0.2">
                {section.content.map((paragraph) => (
                  <p class="mb-4 text-lg leading-loose">{paragraph}</p>
                ))}
                <Link variant="default" class="mt-4" href={section.button.href}>
                  {section.button.label}{" "}
                  <Icon name={section.button.icon ? section.button.icon : ""} />
                </Link>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  import { animate, inView } from "motion";

  document.addEventListener("astro:page-load", () => {
    // Initially set text as invisible and translated down
    const textElements = document.querySelectorAll(".animate-text");
    textElements.forEach((element) => {
      (element as HTMLElement).style.opacity = "0";
      (element as HTMLElement).style.transform = "translateY(20px)";
    });

    // Set up animation when elements enter viewport
    inView(".animate-text", (element) => {
      const delay = element.getAttribute("data-delay") || "0";

      animate(
        element as HTMLElement,
        {
          opacity: [0, 1],
          y: [20, 0],
        },
        {
          duration: 0.5,
          delay: parseFloat(delay),
          easing: [0.25, 0.1, 0.25, 1], // Smooth easing
        }
      );
      return () =>
        animate(
          element as HTMLElement,
          { opacity: 0, y: 0 },
          { duration: 0.5 }
        );
    });
  });
</script>
