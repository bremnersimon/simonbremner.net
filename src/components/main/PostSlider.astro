---
import { Button } from "@/components/shad-ui/button";
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from "@/components/shad-ui/tabs";
import { urlForImage } from "@/lib/sanity";
import type { ProjectCardProps } from "@/types";
import { ChevronLeft, ChevronRight } from "@lucide/astro"; // Using lucide-astro instead of lucide-react
import ProjectCard from "@/components/main/ProjectCard.astro";

interface Props {
  featuredProjects: ProjectCardProps[];
  title?: string;
  subtitle?: string;
  categories?: string[];
  defaultTab?: string;
  lazyLoad?: boolean;
}

const {
  featuredProjects,
  title,
  subtitle,
  categories = ["All", "Photography", "Design", "Development", "Handcrafted"],
  defaultTab = "All",
  lazyLoad = true,
} = Astro.props;

// Helper function to filter projects
const getFilteredProjects = (category: string): ProjectCardProps[] => {
  if (!featuredProjects) return [];

  if (category === "All") {
    return featuredProjects;
  }

  return featuredProjects.filter(
    (project) =>
      project.category &&
      project.category.toLowerCase() === category.toLowerCase()
  );
};

// Convert Sanity posts to the ProjectsGrid format for each category
const projectsByCategory = categories.map((category) => {
  const filteredProjects = getFilteredProjects(category);

  return {
    category,
    projects: filteredProjects.map((post) => ({
      _id: post._id,
      title: post.title,
      slug: post.slug,
      mainImage: {
        src: post.mainImage
          ? urlForImage(post.mainImage).format("webp").width(700).url()
          : "/images/placeholder.jpg",
        alt: post.title,
      },
      category: post.category,
      tags: post.tags || [],
      publishedAt: post.publishedAt,
    })),
  };
});

// Generate unique IDs for each carousel
const carouselIds = categories.map(
  (category) => `embla-${category.toLowerCase().replace(/\s+/g, "-")}`
);
---

<div class="container mx-auto px-4 md:px-0 w-full py-24">
  <div>
    <div class="text-left mb-12">
      <h2 class="text-4xl md:text-6xl font-bold mb-4">{title}</h2>
      {
        subtitle && (
          <p class="text-2xl md:text-4xl text-muted-foreground">{subtitle}</p>
        )
      }
    </div>

    <Tabs defaultValue={defaultTab}>
      <TabsList className="mb-8 hidden md:block text-foreground">
        {
          categories.map((category) => (
            <TabsTrigger
              aria-label={`Tab for ${category} projects`}
              value={category}
              className="px-4">
              {category}
            </TabsTrigger>
          ))
        }
      </TabsList>

      {
        projectsByCategory.map((categoryData, index) => (
          <TabsContent
            aria-label={`Tab content ${categoryData.category} projects`}
            value={categoryData.category}
            className="mt-0">
            <div class="relative mx-auto">
              <div class={`embla ${carouselIds[index]}`}>
                <div class="embla__container flex gap-6">
                  {categoryData.projects?.map((item) => (
                    <div class="embla__slide flex-[0_0_280px] sm:flex-[0_0_350px] md:flex-[0_0_400px] min-w-0">
                      <ProjectCard
                        _id={item._id}
                        title={item.title}
                        mainImage={item.mainImage}
                        slug={item.slug}
                        category={item.category}
                        tags={item.tags}
                        aspectRatio="square"
                      />
                    </div>
                  ))}
                  {categoryData.projects?.length === 0 && (
                    <div class="flex-1 min-h-[300px] flex items-center justify-center">
                      <p class="text-muted-foreground">
                        No projects in this category
                      </p>
                    </div>
                  )}
                </div>
              </div>

              <div class="flex justify-end gap-2 mt-8">
                <Button
                  aria-label="Previous slide"
                  variant="outline"
                  size="icon"
                  className={`prev-button-${carouselIds[index]}`}
                  data-carousel-id={carouselIds[index]}
                  disabled>
                  <ChevronLeft class="h-4 w-4" />
                </Button>
                <Button
                  aria-label="Next slide"
                  variant="outline"
                  size="icon"
                  className={`next-button-${carouselIds[index]}`}
                  data-carousel-id={carouselIds[index]}>
                  <ChevronRight class="h-4 w-4" />
                </Button>
              </div>
            </div>
          </TabsContent>
        ))
      }
    </Tabs>
  </div>
</div>

<script>
  import EmblaCarousel from "embla-carousel";

  // Initialize each carousel
  document.addEventListener("DOMContentLoaded", () => {
    // Get all embla containers
    const emblaNodes = document.querySelectorAll(".embla");

    emblaNodes.forEach((emblaNode) => {
      if (!emblaNode) return;

      const carouselId = emblaNode.classList[1]; // Get the unique ID class
      const options = {
        align: "start",
        slidesToScroll: 1,
        containScroll: "keepSnaps",
      };

      // Initialize the carousel
      const emblaApi = EmblaCarousel(emblaNode as HTMLElement, {});

      // Get the navigation buttons for this specific carousel
      const prevButton = document.querySelector(
        `.prev-button-${carouselId}`
      ) as HTMLButtonElement;
      const nextButton = document.querySelector(
        `.next-button-${carouselId}`
      ) as HTMLButtonElement;

      if (!prevButton || !nextButton) return;

      // Button click handlers
      const scrollPrev = () => emblaApi.scrollPrev();
      const scrollNext = () => emblaApi.scrollNext();

      // Connect the button click events
      prevButton.addEventListener("click", scrollPrev);
      nextButton.addEventListener("click", scrollNext);

      // Update button states based on carousel position
      const updateButtonStates = () => {
        prevButton.disabled = !emblaApi.canScrollPrev();
        nextButton.disabled = !emblaApi.canScrollNext();
      };

      // Set initial button states
      updateButtonStates();

      // Listen for carousel events to update button states
      emblaApi.on("select", updateButtonStates);
      emblaApi.on("reInit", updateButtonStates);
    });
  });
</script>

<style>
  .embla {
    overflow: hidden;
    width: 100%;
  }

  .embla__container {
    display: flex;
    height: auto;
  }

  .embla__slide {
    flex: 0 0 auto;
    min-width: 0;
  }
</style>
