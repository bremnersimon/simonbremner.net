---
import ContentBlockWrapper from "./ContentBlockWrapper.astro";

interface Props {
  heading?: string;
  content: {
    _type: string;
    style: string;
    children: {
      _type: string;
      text: string;
    }[];
  }[];
  showLabel?: boolean;
}

const { heading, content, showLabel = true } = Astro.props;
---

<ContentBlockWrapper type="Text Block" showLabel={showLabel}>
  {heading && <h2 class="text-2xl font-bold mb-4">{heading}</h2>}
  <div class="prose max-w-none">
    {
      content.map((block) => (
        <p>{block.children.map((child) => child.text).join("")}</p>
      ))
    }
  </div>
</ContentBlockWrapper>
