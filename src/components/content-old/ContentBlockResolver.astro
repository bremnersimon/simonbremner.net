---
// Import generic content blocks
import TextBlock from "./TextBlock.astro";
import ImageBlock from "./ImageBlock.astro";
import GalleryBlock from "./GalleryBlock.astro";
import QuoteBlock from "./QuoteBlock.astro";
import DividerBlock from "./DividerBlock.astro";

// Import photography-specific blocks
import FeaturedImageBlock from "../photography/FeaturedImageBlock.astro";
import TechSpecsBlock from "../photography/TechSpecsBlock.astro";
import BehindTheScenesBlock from "../photography/BehindTheScenesBlock.astro";

// Import development-specific blocks
import StackBlock from "../development/StackBlock.astro";
import ProcessBlock from "../development/ProcessBlock.astro";
import ChallengeBlock from "../development/ChallengeBlock.astro";
import RepoLinkBlock from "../development/RepoLinkBlock.astro";
import DemoBlock from "../development/DemoBlock.astro";

// Import Sanity utilities
import { urlForImage } from "../../lib/sanity";

interface Props {
    content?: any[];
    contentType?: string;
    metadata?: any;
    showLabels?: boolean;
    block?: any;
    image?: {
        _type: string;
        asset: {
            _ref: string;
        };
        alt: string;
        caption?: string;
    } | null;
}

// Move block type determination outside of the conditional block
const {
    content,
    contentType,
    metadata,
    showLabels = true,
    block,
} = Astro.props;
const blockType = block?._type;
const hasValidBlock = !!blockType;

// Optional: Debug logging
// console.log("Block received:", block);
// console.log("Block type:", blockType);
---

{
    content && Array.isArray(content) && (
        <div class="content-blocks-container">
            {content.map((block) => (
                <Fragment>
                    <Astro.self block={block} showLabels={showLabels} />
                </Fragment>
            ))}
        </div>
    )
}

{
    !content && !block && (
        <div class="bg-red-50 p-4 rounded-md border border-red-200 text-red-700">
            <p>No content blocks received</p>
        </div>
    )
}

{
    block && !hasValidBlock && (
        <div class="bg-red-50 p-4 rounded-md border border-red-200 text-red-700">
            <p>Invalid content block received (missing _type)</p>
        </div>
    )
}

{
    block && hasValidBlock && blockType === "textBlock" && (
        <TextBlock
            heading={block.heading}
            content={block.content || []}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "imageBlock" && (
        <ImageBlock
            image={urlForImage(block.images || block.image).url()}
            size={block.size}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "galleryBlock" && (
        <GalleryBlock
            title={block.title}
            images={[block.images]
                .filter((image) => image && image.asset)
                .map((image: any) => urlForImage(image).url())}
            layout={block.layout}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "quoteBlock" && (
        <QuoteBlock
            quote={block.quote || ""}
            attribution={block.attribution}
            style={block.style}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "dividerBlock" && (
        <DividerBlock style={block.style} showLabel={showLabels} />
    )
}
{
    block && hasValidBlock && blockType === "featuredImageBlock" && (
        <FeaturedImageBlock
            image={urlForImage(block.image || {}).url()}
            size={block.size}
            imageMetadata={block.imageMetadata}
            showMetadata={block.showMetadata}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "techSpecsBlock" && (
        <TechSpecsBlock
            title={block.title}
            specs={block.specs || []}
            layout={block.layout}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "behindTheScenesBlock" && (
        <BehindTheScenesBlock
            title={block.title}
            description={block.description || []}
            images={(block.images || []).map((image: any) =>
                urlForImage(image || {}).url(),
            )}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "stackBlock" && (
        <StackBlock
            heading={block.heading}
            technologies={block.technologies || []}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "processBlock" && (
        <ProcessBlock
            heading={block.heading}
            phases={block.phases || []}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "challengeBlock" && (
        <ChallengeBlock
            heading={block.heading}
            challenges={block.challenges || []}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "repoLinkBlock" && (
        <RepoLinkBlock
            heading={block.heading}
            repository={block.repository}
            liveUrl={block.liveUrl}
            showLabel={showLabels}
        />
    )
}

{
    block && hasValidBlock && blockType === "demoBlock" && (
        <DemoBlock
            heading={block.heading}
            demoType={block.demoType}
            demoContent={block.demoContent || []}
            showLabel={showLabels}
        />
    )
}
