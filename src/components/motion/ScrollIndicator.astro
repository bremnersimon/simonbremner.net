<div
  class="progress-bar fixed bottom-0 left-0 right-0 h-2 bg-primary z-50"
  style="--scroll-progress: ${scrollYProgress};">
</div>
<slot />

<script>
  import { animate } from "motion/mini";
  import { scroll } from "motion";
  document.addEventListener("astro:page-load", () => {
    const progressAnimation = animate(".progress-bar", { right: ["100%", 0] });
    scroll(progressAnimation);
  });
</script>
