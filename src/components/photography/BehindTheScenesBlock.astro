---
import ContentBlockWrapper from "../content/ContentBlockWrapper.astro";

interface BtsImage {
    _type: string;
    asset: {
        _ref: string;
    };
    alt: string;
    caption?: string;
}

interface Props {
    title?: string;
    description: {
        _type: string;
        style: string;
        children: {
            _type: string;
            text: string;
        }[];
    }[];
    images: BtsImage[];
    showLabel?: boolean;
}

const {
    title = "Behind the Scenes",
    description,
    images,
    showLabel = true,
} = Astro.props;

// In a real implementation, you would use Sanity image URL builder here
const imageSrc = "/images/example.png"; // Placeholder
---

<ContentBlockWrapper type="Behind the Scenes Block" showLabel={showLabel}>
    <h3 class="text-xl font-semibold mb-4">{title}</h3>

    <div class="prose max-w-none mb-6">
        {
            description.map((block) => (
                <p>{block.children.map((child) => child.text).join("")}</p>
            ))
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
            images.map((image) => (
                <div class="relative rounded-lg overflow-hidden">
                    <img src={imageSrc} alt={image.alt} class="w-full h-auto" />
                    {image.caption && (
                        <div class="absolute bottom-0 left-0 right-0 bg-black/70 text-white p-3 text-sm">
                            {image.caption}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</ContentBlockWrapper>
