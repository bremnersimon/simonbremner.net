---
import { Badge } from "@/components/ui/badge";

interface RelatedContent {
    _ref: string;
    _type: string;
}

interface Props {
    location: {
        name: string;
        city?: string;
        country: string;
        coordinates?: {
            _type: string;
            lat: number;
            lng: number;
        };
    };
    tags: string[];
    technicalNotes?: string;
    relatedContent?: RelatedContent[];
}

const { location, tags, technicalNotes, relatedContent = [] } = Astro.props;
---

<div class="mt-24 bg-black p-8 rounded-lg">
    <h3 class="text-xl font-semibold mb-6">About this Project</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
            <h4 class="font-medium mb-2">Location</h4>
            <p>
                {location.name}
                {location.city && `, ${location.city}`}
                {location.country && `, ${location.country}`}
            </p>

            <h4 class="font-medium mt-6 mb-2">Tags</h4>
            <div class="flex flex-wrap gap-2">
                {tags.map((tag) => <Badge variant="outline">{tag}</Badge>)}
            </div>
        </div>

        <div>
            {
                technicalNotes && (
                    <>
                        <h4 class="font-medium mb-2">Technical Notes</h4>
                        <p class="text-sm">{technicalNotes}</p>
                    </>
                )
            }

            {
                relatedContent.length > 0 && (
                    <>
                        <h4 class="font-medium mt-6 mb-2">Related Projects</h4>
                        <div class="space-y-2">
                            {relatedContent.map((item) => (
                                <div class="bg-black p-3 rounded border text-sm">
                                    {item._ref.replace("photography-", "")}
                                </div>
                            ))}
                        </div>
                    </>
                )
            }
        </div>
    </div>
</div>
