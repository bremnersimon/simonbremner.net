---
import { getPortfolioCategoryLabels } from "@/lib/portfolio";

interface Props {
	headline?: string;
	categories?: string[];
}

const { headline, categories = [] } = Astro.props;
const labels = getPortfolioCategoryLabels(categories);
---

<section class="space-y-4">
	<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{headline || "Untitled Project"}</h1>
	{labels.length > 0 && (
		<ul class="flex flex-wrap gap-2" aria-label="Portfolio categories">
			{labels.map((label) => (
				<li class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground">{label}</li>
			))}
		</ul>
	)}
</section>
