---
import {
    type PortfolioPortableTextBlock,
    PortfolioRichTextEntry,
} from "@/components/portfolio/content/PortfolioRichTextEntry";

interface Props {
    introduction?: PortfolioPortableTextBlock[];
}

const { introduction } = Astro.props;
---

<section class="max-w-3xl space-y-2" aria-label="Introduction section">
    <h2 class="text-lg font-semibold">Introduction</h2>
    {
        introduction?.length ? (
            <PortfolioRichTextEntry value={introduction} className="text-sm" />
        ) : (
            <p class="text-sm leading-relaxed text-muted-foreground">
                No introduction provided.
            </p>
        )
    }
</section>
