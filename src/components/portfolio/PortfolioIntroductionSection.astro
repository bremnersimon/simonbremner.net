---
interface Props {
    introduction?: string;
}

const { introduction } = Astro.props;
---

<section class="max-w-3xl space-y-2" aria-label="Introduction section">
    <h2 class="text-lg font-semibold">Introduction</h2>
    <p
        class="text-sm leading-relaxed text-muted-foreground whitespace-pre-line"
    >
        {introduction || "No introduction provided."}
    </p>
</section>
