---
import type { PortfolioCallout } from "@/types/portfolio";

interface Props {
    value: PortfolioCallout;
}

const { value } = Astro.props;

const toneClasses: Record<string, string> = {
    info: "border-sky-400/60 bg-sky-50/60 text-sky-900 dark:bg-sky-950/20 dark:text-sky-200",
    success:
        "border-emerald-400/60 bg-emerald-50/60 text-emerald-900 dark:bg-emerald-950/20 dark:text-emerald-200",
    warning:
        "border-amber-400/60 bg-amber-50/60 text-amber-900 dark:bg-amber-950/20 dark:text-amber-200",
    neutral: "border-border/80 bg-card/50 text-foreground",
};

const tone = value.tone || "neutral";
---

<aside
    class={`mx-auto w-full max-w-[1100px] px-5 py-4 ${toneClasses[tone] || toneClasses.neutral}`}
    aria-label="Callout block"
>
    {
        value.title && (
            <h3 class="mb-1 text-sm font-semibold uppercase tracking-wide">
                {value.title}
            </h3>
        )
    }
    <p class="text-sm leading-relaxed">
        {value.body || "No callout text provided."}
    </p>
</aside>
