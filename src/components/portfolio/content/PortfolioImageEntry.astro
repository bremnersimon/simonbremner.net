---
import { urlForImage } from "@/lib/sanity";
import type { PortfolioInlineImage } from "@/types/portfolio";

interface Props {
	value: PortfolioInlineImage;
}

const { value } = Astro.props;
const imageUrl = value?.asset
	? urlForImage(value).width(1800).fit("max").format("webp").url()
	: "";
---

<article class="space-y-2 rounded-lg border border-border/60 bg-card/30 p-3" aria-label="Image block">
	{imageUrl ? (
		<img src={imageUrl} alt={value.alt || "Portfolio content image"} class="w-full rounded-md object-cover" loading="lazy" />
	) : (
		<div class="flex min-h-48 items-center justify-center rounded-md border border-dashed border-border bg-muted/20">
			<p class="text-sm text-muted-foreground">Image asset missing.</p>
		</div>
	)}
	{value.caption && <p class="text-xs text-muted-foreground">{value.caption}</p>}
</article>
