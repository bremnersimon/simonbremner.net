---
interface Props {
    typeName?: string;
}

const { typeName = "unknown" } = Astro.props;
---

<div
    class="border border-dashed border-border bg-muted/20 p-4"
    aria-label="Unknown content block"
>
    <p class="text-sm text-muted-foreground">
        Unsupported content type: {typeName}
    </p>
</div>
