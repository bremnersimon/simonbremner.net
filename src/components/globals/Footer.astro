---
import { Image } from "astro:assets";
import Container from "@/components/main/Container.astro";
import type { FooterProps } from "@/types";
const { year = 2025 } = Astro.props as FooterProps;
const links = [
  { title: "Home", href: "/" },
  {title: "Gallery", href: "/gallery"},
  { title: "About", href: "/about" },
];
---

<footer class="w-full overflow-hidden border-t">
  <Container>
    <div class="flex flex-col gap-4 py-6 px-4 md:px-0">
      <div class="flex flex-col items-start">
        <Image src="/images/icon.svg" width={32} height={32} alt="Logo" />
        <span class="text-lg font-bold text-foreground mt-2">Simon Bremner</span
        >
        <span class="text-sm text-muted-foreground max-w-sm">
          Graphic Designer | Developer | Photographer
        </span>
      </div>
    </div>
    <div class="border-t py-8 px-4 md:px-0 flex flex-row justify-between">
      <div class="flex flex-row flex-wrap gap-4">
        {
          links.map((link) => (
            <ul>
              <li class="text-md md:text-sm mr-4">
                <a href={link.href} aria-label={link.title}>
                  {link.title}
                </a>
              </li>
            </ul>
          ))
        }
      </div>
      <p class="text-sm text-muted-foreground text-right">
        © {year} simonbremner.net. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
