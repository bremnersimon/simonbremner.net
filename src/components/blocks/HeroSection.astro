---
import { Badge } from "@/components/shad-ui/badge";

interface ShootMetadata {
	theme?: string;
}

interface HeroSectionProps {
	title: string;
	mainImage?: string;
	mainImageAlt?: string;
	mainImageCaption?: string;
}
type Props = HeroSectionProps;

const { title, mainImage, mainImageAlt, mainImageCaption } = Astro.props;
---

<div class="relative h-[50vh] md:h-[70vh] mb-16">
  {/* Background image */}
  <div class="absolute inset-0">
    {
      mainImage && (
        <img
          src={mainImage}
          alt={mainImageAlt || title}
          class="w-full h-full object-cover object-center opacity-90"
        />
      )
    }
    {/* Dark gradient overlay for text visibility */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent">
    </div>
  </div>

  {/* Text container - explicitly positioned at bottom */}
  <div class="absolute inset-x-0 bottom-0 pb-8 pt-16">
    <div class="container max-w-5xl mx-auto px-4">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 text-white">
        {title}
      </h1>
      {
        mainImageCaption && (
          <p class="text-xl text-white/90 max-w-3xl">{mainImageCaption}</p>
        )
      }
    </div>
  </div>
</div>
