---
import ContentBlockWrapper from "../content/ContentBlockWrapper.astro";

interface Challenge {
  problem: string;
  solution: any[]; // This would be PortableText content
}

interface Props {
  heading: string;
  challenges: Challenge[];
  showLabel?: boolean;
}

const { heading, challenges = [], showLabel = true } = Astro.props;
---

<ContentBlockWrapper type="Challenges & Solutions" showLabel={showLabel}>
  <div class="challenge-block">
    {heading && <h3 class="text-xl font-semibold mb-4">{heading}</h3>}
    
    <div class="space-y-8">
      {challenges.map((challenge) => (
        <div class="challenge-item bg-black/5 dark:bg-white/10 p-6 rounded-lg">
          <h4 class="text-lg font-medium text-red-600 dark:text-red-400 mb-3">
            Challenge: {challenge.problem}
          </h4>
          
          <div class="solution">
            <h5 class="text-md font-medium text-green-600 dark:text-green-400 mb-2">Solution:</h5>
            <!-- Note: You'll need a PortableText renderer here -->
            <div class="solution-content">
              {/* This is a placeholder - you'll need to implement a PortableText renderer */}
              {challenge.solution && "Solution description would render here using PortableText"}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</ContentBlockWrapper>
