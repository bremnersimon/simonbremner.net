---
import ContentBlockWrapper from "../content/ContentBlockWrapper.astro";

interface Phase {
  phase: string;
  description: any[]; // This would be PortableText content
}

interface Props {
  heading: string;
  phases: Phase[];
  showLabel?: boolean;
}

const { heading, phases = [], showLabel = true } = Astro.props;
---

<ContentBlockWrapper type="Development Process" showLabel={showLabel}>
  <div class="process-block">
    {heading && <h3 class="text-xl font-semibold mb-4">{heading}</h3>}
    
    <div class="space-y-8">
      {phases.map((phase, index) => (
        <div class="phase-item">
          <div class="flex items-center gap-4 mb-2">
            <div class="phase-number flex items-center justify-center w-8 h-8 rounded-full bg-black text-white dark:bg-white dark:text-black font-bold">
              {index + 1}
            </div>
            <h4 class="text-lg font-medium">{phase.phase}</h4>
          </div>
          
          <div class="phase-description ml-12">
            <!-- Note: You'll need a PortableText renderer here -->
            <p>
              {/* This is a placeholder - you'll need to implement a PortableText renderer */}
              {phase.description && "Phase description would render here using PortableText"}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</ContentBlockWrapper>
