---
import ContentBlockWrapper from "./ContentBlockWrapper.astro";

interface Props {
    quote: string;
    attribution?: string;
    style?: "simple" | "pullQuote" | "blockquote";
    showLabel?: boolean;
}

const { quote, attribution, style = "simple", showLabel = true } = Astro.props;
---

<ContentBlockWrapper type="Quote Block" showLabel={showLabel}>
    <div
        class={`
    ${style === "simple" ? "px-4 py-6" : ""}
    ${style === "pullQuote" ? "px-6 py-8 border-l-4 border-primary" : ""}
    ${style === "blockquote" ? "px-6 py-8 text-center" : ""}
    my-12
  `}
    >
        <blockquote class="text-2xl font-serif italic">
            "{quote}"
            {
                attribution && (
                    <footer class="mt-4 text-base font-normal text-muted-foreground">
                        — {attribution}
                    </footer>
                )
            }
        </blockquote>
    </div>
</ContentBlockWrapper>
