---
import "../styles/global.css";
import "highlight.js/styles/github-dark.css";
import MainOgImage from "@/assets/main-og-image.jpg";
import Footer from "@/components/globals/Footer.astro";
import { IntroAnimation } from "@/components/globals/IntroAnimation";
import { Navbar } from "@/components/globals/Navbar";
import CommonHead from "@/components/seo/CommonHead.astro";
import SEO from "@/components/seo/SEO.astro";
import TagManager from "@/components/seo/TagManager.astro";
import TagManagerBody from "@/components/seo/TagManagerBody.astro";
import type { SEOProps } from "@/types/types";

const year = new Date().getFullYear();

type Props = SEOProps;

const {
  title = "Portfolio | Simon Bremner",
  description = "A Creative Portfolio",
  pageType = "website",
  noindex = false,
  nofollow = false,
  image,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <TagManager />
    <SEO
      title={title}
      description={description}
      pageType={pageType}
      noindex={noindex}
      nofollow={nofollow}
      image={image ? image : MainOgImage.src}
      article={article ? article : undefined}
    />
    <CommonHead title={title} description={description} />
    <script is:inline>
      // Anti-flash gate for the opening animation: mark the document before
      // first paint so a static cover hides content until the island hydrates.
      try {
        if (!sessionStorage.getItem("intro-played")) {
          document.documentElement.setAttribute("data-intro", "pending");
        }
      } catch {}
    </script>
    <style is:global>
      #intro-cover {
        display: none;
      }
      html[data-intro="pending"] #intro-cover {
        display: block;
      }
    </style>
    <slot name="head" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body
    class="text-foreground bg-background flex flex-col min-h-screen m-0 w-full h-full"
  >
    <TagManagerBody />
    <div
      id="intro-cover"
      aria-hidden="true"
      class="bg-background pointer-events-none fixed inset-0 z-50"
      transition:persist
    >
    </div>
    <IntroAnimation client:load transition:persist />
    <Navbar
      client:idle
      transition:name="navbar"
      transition:persist
      transition:animate="none"
    />
    <main id="page-content" class="flex-grow">
      <slot />
    </main>
    <Footer title={title} year={year} transition:animate="none" />
  </body>
</html>
